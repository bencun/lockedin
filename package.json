{
  "name": "@bencun/lockedin",
  "description": "LockedIn Chrome and Firefox browser extension for blocking LinkedIn's feed",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build-all-clean": "rimraf .output && pnpm zip && pnpm zip:firefox",
    "compile": "tsc --noEmit",
    "docs": "tsx .scripts/generate-docs.ts",
    "generate:icons": "tsx .scripts/generate-icons.ts",
    "postinstall": "wxt prepare",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sharp": "^0.34.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
